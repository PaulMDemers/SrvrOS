+/* Shared by the SrvrOS x86-64 stub table and the closure allocator. */
+#define FFI_SRVROS_SLOTS 128
+#define FFI_SRVROS_STUB_SIZE 32
+#define FFI_SRVROS_SLOT_SIZE 16
+#define FFI_SRVROS_SLOT_TARGET 8
+
+#ifndef LIBFFI_ASM
+ffi_status ffi_srvros_prep_closure (ffi_closure *, ffi_cif *,
+  void (*)(ffi_cif *, void *, void **, void *), void *, void *,
+  void (*)(void)) FFI_HIDDEN;
+#endif
--- /dev/null
+++ b/src/x86/srvros-closures.inc
@@ -0,0 +1,122 @@
+/* SrvrOS keeps trampoline code in linked text and per-closure state in data.
+   Callers must publish the prepared entry before calling it on another thread,
+   and finish all calls to it before preparing it again or freeing the closure. */
+#include <pthread.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include "srvros-tramp.h"
+
+struct srvros_slot
+{
+  ffi_closure *closure;
+  void (*target)(void);
+};
+
+_Static_assert (sizeof (struct srvros_slot) == FFI_SRVROS_SLOT_SIZE,
+                "assembly slot size");
+_Static_assert (offsetof (struct srvros_slot, target) == FFI_SRVROS_SLOT_TARGET,
+                "assembly target offset");
+
+struct srvros_slot ffi_srvros_slots[FFI_SRVROS_SLOTS] FFI_HIDDEN;
+extern const unsigned char ffi_srvros_stubs[] FFI_HIDDEN;
+static pthread_mutex_t slots_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static size_t
+slot_for (const void *closure)
+{
+  for (size_t i = 0; i < FFI_SRVROS_SLOTS; i++)
+    if (ffi_srvros_slots[i].closure == closure)
+      return i;
+  return FFI_SRVROS_SLOTS;
+}
+
+static void *
+slot_entry (size_t slot)
+{
+  return (void *) (ffi_srvros_stubs + slot * FFI_SRVROS_STUB_SIZE);
+}
+
+void *
+ffi_closure_alloc (size_t size, void **code)
+{
+  if (!code)
+    return NULL;
+  *code = NULL;
+  if (size < sizeof (ffi_closure))
+    return NULL;
+
+  ffi_closure *closure = malloc (size);
+  if (!closure)
+    return NULL;
+
+  pthread_mutex_lock (&slots_lock);
+  size_t slot = slot_for (NULL);
+  if (slot < FFI_SRVROS_SLOTS)
+    {
+      ffi_srvros_slots[slot].closure = closure;
+      *code = slot_entry (slot);
+    }
+  pthread_mutex_unlock (&slots_lock);
+  if (!*code)
+    {
+      free (closure);
+      return NULL;
+    }
+  return closure;
+}
+
+void
+ffi_closure_free (void *closure)
+{
+  if (!closure)
+    return;
+
+  pthread_mutex_lock (&slots_lock);
+  size_t slot = slot_for (closure);
+  if (slot < FFI_SRVROS_SLOTS)
+    ffi_srvros_slots[slot] = (struct srvros_slot) { 0 };
+  pthread_mutex_unlock (&slots_lock);
+  if (slot < FFI_SRVROS_SLOTS)
+    free (closure);
+}
+
+void *
+ffi_data_to_code_pointer (void *closure)
+{
+  if (!closure)
+    return NULL;
+
+  pthread_mutex_lock (&slots_lock);
+  size_t slot = slot_for (closure);
+  pthread_mutex_unlock (&slots_lock);
+  return slot < FFI_SRVROS_SLOTS ? slot_entry (slot) : NULL;
+}
+
+ffi_status
+ffi_srvros_prep_closure (ffi_closure *closure, ffi_cif *cif,
+  void (*fun)(ffi_cif *, void *, void **, void *), void *user_data,
+  void *codeloc, void (*target)(void))
+{
+  if (!closure || !fun)
+    return FFI_BAD_ARGTYPE;
+
+  pthread_mutex_lock (&slots_lock);
+  size_t slot = slot_for (closure);
+  if (slot == FFI_SRVROS_SLOTS || codeloc != slot_entry (slot))
+    {
+      pthread_mutex_unlock (&slots_lock);
+      return FFI_BAD_ARGTYPE;
+    }
+  closure->cif = cif;
+  closure->fun = fun;
+  closure->user_data = user_data;
+  ffi_srvros_slots[slot].target = target;
+  pthread_mutex_unlock (&slots_lock);
+  return FFI_OK;
+}
+
+int
+ffi_tramp_is_present (void *closure)
+{
+  return ffi_data_to_code_pointer (closure) != NULL;
+}

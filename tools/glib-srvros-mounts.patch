+static GUnixMountEntry **
+_g_unix_mounts_get_from_file (const char *table_path,
+                              uint64_t *time_read_out,
+                              size_t *n_entries_out)
+{
+  (void) table_path;
+  if (time_read_out != NULL) *time_read_out = 0;
+  if (n_entries_out != NULL) *n_entries_out = 0;
+  return NULL;
+}
+
+static GList *
+_g_get_unix_mounts (void)
+{
+  struct srv_mount_snapshot snapshot = { .version = SRV_MOUNT_SNAPSHOT_VERSION };
+  GList *mounts = NULL;
+  if (srv_get_mount_snapshot (&snapshot) < 0 ||
+      snapshot.version != SRV_MOUNT_SNAPSHOT_VERSION || snapshot.count == 0 ||
+      snapshot.count > SRV_MOUNT_SNAPSHOT_MAX)
+    return NULL;
+  for (guint i = 0; i < snapshot.count; ++i)
+    {
+      const struct srv_mount_entry *item = &snapshot.entries[i];
+      const char *type;
+      if (item->filesystem == SRV_MOUNT_VFS) type = "srvros-vfs";
+      else if (item->filesystem == SRV_MOUNT_EXFAT) type = "exfat";
+      else goto invalid;
+      if (!memchr (item->mount_path, 0, sizeof item->mount_path) ||
+          !memchr (item->root_path, 0, sizeof item->root_path) ||
+          !memchr (item->source, 0, sizeof item->source) ||
+          item->mount_path[0] != '/' || item->root_path[0] != '/' ||
+          (item->flags & ~(SRV_MOUNT_READONLY | SRV_MOUNT_PROJECTION)))
+        goto invalid;
+      GUnixMountEntry *entry = g_new0 (GUnixMountEntry, 1);
+      entry->mount_path = g_strdup (item->mount_path);
+      entry->root_path = g_strdup (item->root_path);
+      entry->device_path = g_strdup (item->source);
+      entry->filesystem_type = g_strdup (type);
+      entry->is_read_only = (item->flags & SRV_MOUNT_READONLY) != 0;
+      entry->is_system_internal = item->filesystem == SRV_MOUNT_VFS ||
+                                  (item->flags & SRV_MOUNT_PROJECTION) != 0;
+      entry->options = g_strdup (entry->is_read_only ? "ro" : "rw");
+      mounts = g_list_prepend (mounts, entry);
+    }
+  return g_list_reverse (mounts);
+invalid:
+  g_list_free_full (mounts, (GDestroyNotify) g_unix_mount_entry_free);
+  return NULL;
+}

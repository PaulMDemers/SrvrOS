--- meson.build
+++ meson.build
@@ -836,4 +836,13 @@
 foreach f : functions
+  if host_system == 'srvros' and f in ['recvmmsg', 'sendmmsg']
+    # The SDK links private Node shims before exposing the public socket API.
+    # Require the declaration as well as the link before using the fast path.
+    if not cc.has_header_symbol('sys/socket.h', f) or \
+       not cc.has_member('struct mmsghdr', 'msg_hdr', prefix : '#include <sys/socket.h>')
+      set_variable('have_func_' + f, false)
+      continue
+    endif
+  endif
   if cc.has_function(f)
     define = 'HAVE_' + f.underscorify().to_upper()
     glib_conf.set(define, 1)
--- gio/gsocket.c
+++ gio/gsocket.c
@@ -3281,6 +3281,6 @@
 g_socket_get_available_bytes (GSocket *socket)
 {
-#ifndef SO_NREAD
+#if !defined(SO_NREAD) && !defined(__SRVROS__)
   const gint bufsize = 64 * 1024;
   static guchar *buf = NULL;
 #endif
@@ -3298,5 +3298,9 @@
-#ifdef SO_NREAD
+#if defined(__SRVROS__)
+  /* The SDK reports the next datagram length without a consuming read. */
+  if (ioctl (socket->priv->fd, FIONREAD, &avail) < 0)
+    return -1;
+#elif defined(SO_NREAD)
   if (!g_socket_get_option (socket, SOL_SOCKET, SO_NREAD, &avail, NULL))
       return -1;
 #else
   if (socket->priv->type == G_SOCKET_TYPE_DATAGRAM)

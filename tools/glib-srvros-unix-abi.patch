+++ glib/glib-unix.c
@@ -1000,2 +1000,8 @@
   return g_strdup (file_path);
+#elif defined (__SRVROS__)
+  /* The SDK provides directory handle paths, but no general FD path query. */
+  (void) fd;
+  g_set_error_literal (error, G_FILE_ERROR, G_FILE_ERROR_NOSYS,
+                       "File descriptor path queries are not supported on SrvrOS");
+  return NULL;
 #elif defined (__GNU__)

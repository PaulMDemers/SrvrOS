--- meson.build
+++ meson.build
@@ -1795,4 +1795,10 @@
 else
-  glibconfig_conf.set('g_pid_type', 'int')
-  glibconfig_conf.set_quoted('g_pid_format', 'i')
+  if host_system == 'srvros'
+    # SrvrOS pid_t is int64_t. Use its detected C type and format.
+    glibconfig_conf.set('g_pid_type', 'gint64')
+    glibconfig_conf.set_quoted('g_pid_format', gint64_format)
+  else
+    glibconfig_conf.set('g_pid_type', 'int')
+    glibconfig_conf.set_quoted('g_pid_format', 'i')
+  endif
   glibconfig_conf.set_quoted('g_pollfd_format', '%d')

--- glib/gmain.c
+++ glib/gmain.c
@@ -71,0 +72,5 @@
+#if defined(__SRVROS__) && !defined(NSIG)
+#include <limits.h>
+/* The SDK indexes its signal mask by signum, with slot zero reserved. */
+#define NSIG ((int) (sizeof (sigset_t) * CHAR_BIT))
+#endif
@@ -5977,2 +5982,5 @@
-  unix_child_watches = g_slist_remove (unix_child_watches, source);
-  unref_unix_signal_handler_unlocked (SIGCHLD);
+  if (g_slist_find (unix_child_watches, source))
+    {
+      unix_child_watches = g_slist_remove (unix_child_watches, source);
+      unref_unix_signal_handler_unlocked (SIGCHLD);
+    }
@@ -6140 +6148 @@
-static void
+static gboolean
@@ -6145,2 +6153 @@
-  unix_signal_refcount[signum]++;

@@ -6150,0 +6158 @@
+      action.sa_flags = 0;
@@ -6152,3 +6160 @@
-      action.sa_flags = SA_RESTART | SA_NOCLDSTOP;
-#else
-      action.sa_flags = SA_NOCLDSTOP;
+      action.sa_flags |= SA_RESTART;
@@ -6155,0 +6162,2 @@
+#ifndef __SRVROS__
+      action.sa_flags |= SA_NOCLDSTOP;
@@ -6159,2 +6167,6 @@
-      sigaction (signum, &action, NULL);
-    }
+#endif
+      if (sigaction (signum, &action, NULL) < 0)
+        return FALSE;
+    }
+  unix_signal_refcount[signum]++;
+  return TRUE;
@@ -6255 +6267,9 @@
-  ref_unix_signal_handler_unlocked (signum);
+  if (!ref_unix_signal_handler_unlocked (signum))
+    {
+      const int saved_errno = errno;
+      G_UNLOCK (unix_signal_lock);
+      g_source_unref (source);
+      g_warning ("Cannot install signal handler for %d: %s", signum,
+                 g_strerror (saved_errno));
+      return NULL;
+    }
@@ -6271,2 +6291,5 @@
-  unref_unix_signal_handler_unlocked (unix_signal_source->signum);
-  unix_signal_watches = g_slist_remove (unix_signal_watches, source);
+  if (g_slist_find (unix_signal_watches, source))
+    {
+      unref_unix_signal_handler_unlocked (unix_signal_source->signum);
+      unix_signal_watches = g_slist_remove (unix_signal_watches, source);
+    }
@@ -6547 +6570,9 @@
